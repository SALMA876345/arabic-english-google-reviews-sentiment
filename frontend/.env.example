# Copy this file to .env.local (or .env) and adjust for your environment.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Base URL of the FastAPI backend. Defaults to http://localhost:8000 in code
# if this is unset, so .env is optional for local development.
VITE_API_BASE_URL=http://localhost:8000
